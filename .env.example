# ---- What to run ------------------------------------------------------------
# local-ai = run the AI (Ollama) on this machine, https = automatic HTTPS for DOMAIN.
# Examples: "local-ai" (your computer), "https" (server + Groq), "https,local-ai".
COMPOSE_PROFILES=local-ai
# Your public address, used when the https profile is on.
DOMAIN=localhost

# ---- Platform -------------------------------------------------------------
# development: API docs at /docs and demo logins on the login page (your computer).
# production: both hidden, strong secrets required (servers; the installer sets this).
ENVIRONMENT=development
# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
# Your platform owner (system admin) login, created on first start.
SYSTEM_ADMIN_EMAIL=owner@example.com
SYSTEM_ADMIN_PASSWORD=ChangeMe123!
SYSTEM_ADMIN_NAME=Platform Owner
# Creates the "Sunrise Travel" demo company with sample packages and staff logins.
# Set to false for a real deployment.
SEED_DEMO_DATA=true
WEB_PORT=8080
# 0.0.0.0 = reachable from other machines; 127.0.0.1 = only through HTTPS (servers).
WEB_BIND=0.0.0.0
CORS_ORIGINS=http://localhost:8080

# ---- Database (used by docker-compose) --------------------------------------
POSTGRES_USER=travel
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=travel_ai

# ---- AI brain (open source) -------------------------------------------------
# Default: Ollama inside docker-compose, running the customised "travel-agent" model.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=travel-agent
LLM_TEMPERATURE=0.3
# Base model for the travel-agent build: qwen2.5:7b (default), qwen2.5:3b (faster on CPU),
# qwen2.5:14b or llama3.1:8b.
BASE_MODEL=qwen2.5:7b
#
# No GPU server? Use open models hosted by an OpenAI-compatible provider, e.g. Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_FALLBACK_MODELS=openai/gpt-oss-20b
#   LLM_REASONING_EFFORT=low
#   LLM_API_KEY=<your provider key>
# Providers retire models from time to time: the "Test AI" button in the platform
# console shows the exact error, and LLM_FALLBACK_MODELS are tried automatically.
# Or LLM_PROVIDER=mock for a demo without any model.

# ---- WhatsApp Cloud API (Meta) ------------------------------------------------
# Token you type in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
# Meta App > Settings > Basic > App secret (verifies that webhooks come from Meta).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Optional fallback token if a company has not saved its own.
WHATSAPP_DEFAULT_ACCESS_TOKEN=
