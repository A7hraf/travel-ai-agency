# Copy to .env and replace every placeholder. Never commit .env.

# ---- Docker Compose -----------------------------------------------------------
# Optional services, comma separated: "local-ai" (Ollama), "https" (Caddy).
COMPOSE_PROFILES=local-ai
# Public domain used by the https profile.
DOMAIN=localhost
# Port and bind address of the web container.
WEB_PORT=8080
WEB_BIND=0.0.0.0

# ---- Application --------------------------------------------------------------
# "development" locally, "production" on any public deployment.
ENVIRONMENT=development
# Long random value (32+ characters).
SECRET_KEY=replace-with-a-long-random-string
# Optional key for stored credentials; empty = derived from SECRET_KEY.
ENCRYPTION_KEY=
# Platform administrator, created on first start. Must be changed for production.
SYSTEM_ADMIN_EMAIL=owner@example.com
SYSTEM_ADMIN_PASSWORD=ChangeMe123!
SYSTEM_ADMIN_NAME=Platform Owner
# Create a demo company (false for real deployments).
SEED_DEMO_DATA=true
# Allowed browser origins, comma separated.
CORS_ORIGINS=http://localhost:8080

# ---- Database -----------------------------------------------------------------
POSTGRES_USER=travel
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=travel_ai

# ---- AI provider (OpenAI-compatible API) --------------------------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=travel-agent
# Optional backup models, comma separated.
LLM_FALLBACK_MODELS=
# Optional, for reasoning models.
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=0.3
# Base model pulled by the local-ai profile.
BASE_MODEL=qwen2.5:7b

# ---- Meta messaging (shared platform app, optional) ---------------------------
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_ACCESS_TOKEN=
